# ---- Nebius Token Factory (all LLM inference) ----
# Get both from the Token Factory console. DO NOT GUESS EITHER OF THESE.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=

# ---- Tavily (Research agent + nightly memory grounding) ----
# Credits come with the Nebius Builder Program.
TAVILY_API_KEY=

# ---- Supabase (Postgres + pgvector memory store) ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- Google (Calendar + Email agents) ----
# gmail.send scope only — avoids the CASA audit on restricted scopes.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- Agent host ----
HOST_URL=http://lifeos-vm:8000

# ---- Demo mode ----
# true swaps every data source for synthetic fixtures in fixtures/.
# DEMO=true MUST run the entire system with zero real credentials.
DEMO=true
